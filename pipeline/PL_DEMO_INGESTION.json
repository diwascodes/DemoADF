						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select watermark_value from metadata.table_watermarks where table_name='@{pipeline().parameters.table_name}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
